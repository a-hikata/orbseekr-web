---
interface Column {
  key: string;
  label: string;
  numeric?: boolean;
}

interface Props {
  columns: Column[];
  rows: Record<string, string | number>[];
  caption?: string;
}

const { columns, rows, caption } = Astro.props;
---

<div class="table-scroll">
  <table class="table">
    {caption && <caption class="visually-hidden">{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col) => <th scope="col">{col.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {columns.map((col) => (
              <td class={col.numeric ? 'table__cell--numeric' : undefined}>{row[col.key]}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .table th,
  .table td {
    text-align: left;
    padding: var(--space-12) var(--space-16);
    border-bottom: var(--border-width) solid var(--color-border);
    white-space: nowrap;
  }

  .table thead th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .table tbody tr:last-child td {
    border-bottom: none;
  }

  .table__cell--numeric {
    font-family: var(--font-mono);
    text-align: right;
  }
</style>
