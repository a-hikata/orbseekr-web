---
interface Props {
  href: string;
  external?: boolean;
  showArrow?: boolean;
}

const { href, external = true, showArrow = false } = Astro.props;
---

<a class="text-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <slot />{showArrow && <span aria-hidden="true"> →</span>}
</a>

<style>
  .text-link {
    color: var(--color-signal-blue-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: var(--font-weight-regular);
    transition: color var(--motion-hover-duration) var(--motion-hover-easing);
  }

  .text-link:hover {
    color: var(--color-orbit-navy);
  }
</style>
