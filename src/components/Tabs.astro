---
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  groupId: string;
}

const { tabs, groupId } = Astro.props;
---

<div class="tabs" data-tabs={groupId}>
  <div class="tabs__list" role="tablist">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${groupId}-tab-${tab.id}`}
          aria-controls={`${groupId}-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="tabs__tab"
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="tabs__panels">
    <slot />
  </div>
</div>

<script>
  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const groupId = root.dataset.tabs;

    function select(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${groupId}-panel-${t.dataset.tab}`);
        if (panel) panel.hidden = !selected;
      });
      tab.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length]);
        if (e.key === 'ArrowLeft') select(tabs[(i - 1 + tabs.length) % tabs.length]);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>

<style>
  .tabs__list {
    display: flex;
    gap: var(--space-8);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-24);
  }

  .tabs__tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: var(--space-12) var(--space-4);
    margin-bottom: -1px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
    min-height: 44px;
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-signal-blue);
  }
</style>
