---
// Lucide line icons only, 1.5px stroke, currentColor, round cap (Design Book 05 / ICON STYLE).
// This component renders the icon alone — every call site must place a visible
// text label next to it; an icon never carries meaning by itself.
import { createRequire } from 'node:module';
import fs from 'node:fs';

interface Props {
  name: string;
  size?: 16 | 20 | 24 | 32;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const require = createRequire(import.meta.url);
const iconPath = require.resolve(`lucide-static/icons/${name}.svg`);
let svg = fs.readFileSync(iconPath, 'utf-8');

svg = svg
  .replace(/<!--.*?-->\s*/s, '')
  .replace(/\sclass="[^"]*"/, '')
  .replace('width="24"', `width="${size}"`)
  .replace('height="24"', `height="${size}"`)
  .replace('stroke-width="2"', 'stroke-width="1.5"')
  .replace('<svg', `<svg aria-hidden="true" focusable="false" class="icon${className ? ` ${className}` : ''}"`);
---

<Fragment set:html={svg} />

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
