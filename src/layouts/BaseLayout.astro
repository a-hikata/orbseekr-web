---
// Subset-scoped imports only (latin / japanese) — the unscoped per-weight
// files bundle every subset (cyrillic, vietnamese, greek, ...) and were
// blowing the render-blocking CSS up to 500+ KiB for glyphs this site never
// uses.
// Weight 300 is a defined design token (--font-weight-light) but nothing on
// the page currently renders at it — its webfont file is not imported so it
// isn't shipped; add it back if a future section actually uses it.
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans-jp/japanese-400.css';
import '@fontsource/ibm-plex-sans-jp/japanese-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { meta } from '../content/ja/meta';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.titleJa, description = meta.descriptionJa } = Astro.props;
// `Astro.site` is the single source of the origin (see astro.config.mjs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Join against BASE_URL so assets resolve under a Pages project subpath too.
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const ogImageURL = new URL(withBase('og-image.png'), Astro.site);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'eo-claim-lint',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'GitHub Actions, Linux, macOS, Windows',
    description:
      'A linter for checking whether Earth observation claims distinguish measurements, estimates, uncertainty, and supporting evidence.',
    softwareVersion: '0.1.0',
    license: 'https://github.com/a-hikata/eo-claim-lint/blob/main/LICENSE',
    url: 'https://github.com/a-hikata/eo-claim-lint',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'OrbSeekr',
    url: Astro.site?.href,
    sameAs: ['https://github.com/a-hikata/eo-claim-lint'],
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" sizes="any" href={withBase('favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OrbSeekr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />)}
  </head>
  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
