---
import { problem } from '../content/ja/problem';
---

<section id="problem" class="section section--surface">
  <div class="container">
    <span class="section__eyebrow">{problem.eyebrow}</span>
    <h2 class="section__title">{problem.title}</h2>
    <p class="section__lede">{problem.lede}</p>

    <ul class="problem__kinds">
      {
        problem.mixedKinds.map((kind) => (
          <li class="problem__kind">
            <span class="problem__kind-label">{kind.label}</span>
            <span class="problem__kind-desc">{kind.description}</span>
          </li>
        ))
      }
    </ul>

    <ul class="problem__consequences measure">
      {problem.consequences.map((item) => <li>{item}</li>)}
    </ul>

    <p class="problem__reframe measure">{problem.reframe}</p>
  </div>
</section>

<style>
  .problem__kinds {
    margin-top: var(--space-32);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12);
  }

  .problem__kind {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-12) var(--space-16);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .problem__kind-label {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-semibold);
    font-size: 0.875rem;
  }

  .problem__kind-desc {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .problem__consequences {
    margin-top: var(--space-32);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .problem__consequences li {
    padding-left: var(--space-24);
    position: relative;
  }

  .problem__consequences li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-danger-text);
  }

  .problem__reframe {
    margin-top: var(--space-32);
    font-size: 1.125rem;
    font-weight: var(--font-weight-semibold);
    border-left: 2px solid var(--color-orbit-navy);
    padding-left: var(--space-16);
  }

  @media (min-width: 640px) {
    .problem__kinds {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
